DATABASE_URL="postgresql://postgres:postgres@localhost:5432/colibly_db?schema=public"
# openssl rand -base64 32
AUTH_SECRET="generate-a-random-secret-here"
# openssl rand -hex 32  (64 hex chars = 32 bytes, AES-256-GCM) — llave maestra:
# cifra tanto los secretos por-cuenta (WAAccount, etc.) como los de
# PlatformSettings (IA/Stripe/SMTP/Turnstile/medición, ver /plataforma), así
# que no puede vivir en la misma base que cifra.
ENCRYPTION_KEY=""
REDIS_URL="redis://redis:6379"
NEXT_PUBLIC_APP_URL="http://localhost:15100"
# URL pública en tiempo de ejecución (enlaces de correos y de Stripe). En
# producción es OBLIGATORIA: https://app.colibly.com. En DEV con túnel
# público, usar la URL temporal para que verificación/invitaciones no apunten a localhost.
APP_URL=""
# Web pública y enlaces canónicos. En producción: https://colibly.com
SITE_URL=""
# Solo si el webhook de Telegram entra por un túnel/proxy distinto al origen
# donde se abre la interfaz. Ejemplo DEV: https://tunnel.example.com
TELEGRAM_WEBHOOK_BASE_URL=""
WHATSAPP_WEBHOOK_BASE_URL=""

# Password del Postgres del docker-compose de producción — OBLIGATORIA, el
# stack no arranca sin ella (sin default inseguro).
DB_PASSWORD=""

# Integración Google Sheets (leads de Facebook) — opcional
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:15100/api/integrations/google-sheets/callback"

# Media de WhatsApp — opcionales, defaults sensatos
# MEDIA_ROOT="/app/media"
# Días de retención de archivos de media descargados; 0 o negativo = no purgar
# MEDIA_RETENTION_DAYS="90"

# Operadores de la plataforma: correos (separados por comas) que ven el panel
# /plataforma (todas las organizaciones, extender pruebas, dar créditos,
# suspender, y la configuración de negocio de abajo). Vacío = nadie.
# Deliberadamente fuera de PlatformSettings: es el perímetro de acceso al
# propio panel, cambiarlo requiere el servidor/Coolify, no solo la GUI.
PLATFORM_ADMIN_EMAILS=""

# Pool de Postgres por proceso (lib/prisma.ts). Vacío = default de Prisma
# (núcleos × 2 + 1). Recomendado: 20 y 10 s.
DB_CONNECTION_LIMIT=""
DB_POOL_TIMEOUT=""

# Límites de la API pública /api/v1 y webhooks (lib/api/constants.ts).
# Vacío = default. /docs/api es estática: el valor debe existir también al construir.
API_RATE_LIMIT_PER_KEY=""                # 120/min
API_RATE_LIMIT_PER_ORG=""                # 600/min (todas las keys)
API_RATE_LIMIT_PER_IP=""                 # 3000/min
API_RATE_LIMIT_SEND_PER_ORG=""           # 60/min en POST /messages
API_RATE_LIMIT_CONVERSATIONS_PER_KEY=""  # 60/min en GET /conversations
API_DAILY_SEND_CAP_PER_ORG=""            # 10000/día UTC en POST /messages
API_MAX_BODY_BYTES=""                    # 1048576
API_AUTH_CACHE_SECONDS=""                # 60
WEBHOOK_WORKER_CONCURRENCY=""            # 20
WEBHOOK_PER_ENDPOINT_CONCURRENCY=""      # 2

# Correo transaccional, Stripe, IA (OpenCode Go + Google), captcha (Cloudflare
# Turnstile) y medición del sitio público (Meta Pixel/CAPI, GA4, Google Ads)
# YA NO son variables de entorno — se configuran desde /plataforma (pestaña
# "Configuración"), guardadas cifradas en la tabla PlatformSettings
# (lib/platform-settings.ts). En desarrollo, sin nada configurado ahí: el
# correo se imprime en el log del contenedor, no hay pagos ni captcha, y no se
# carga ningún script de medición.

# Chat web de la landing: id de una cuenta WEBCHAT de la organización propia
# (sus orígenes permitidos deben incluir el dominio público).
LANDING_WEBCHAT_ACCOUNT_ID=""
