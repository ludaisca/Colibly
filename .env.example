DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sunday_crm_db?schema=public"
# openssl rand -base64 32
AUTH_SECRET="generate-a-random-secret-here"
# openssl rand -hex 32  (64 hex chars = 32 bytes, AES-256-GCM)
ENCRYPTION_KEY=""
REDIS_URL="redis://redis:6379"
NEXT_PUBLIC_APP_URL="http://localhost:3002"
# URL pública en tiempo de ejecución (enlaces de correos y de Stripe). En
# producción es OBLIGATORIA: https://tu-dominio
APP_URL=""

# Password del Postgres del docker-compose de producción — OBLIGATORIA, el
# stack no arranca sin ella (sin default inseguro).
DB_PASSWORD=""

# Integración Google Sheets (leads de Facebook) — opcional
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3002/api/integrations/google-sheets/callback"

# Media de WhatsApp — opcionales, defaults sensatos
# MEDIA_ROOT="/app/media"
# Días de retención de archivos de media descargados; 0 o negativo = no purgar
# MEDIA_RETENTION_DAYS="90"

# Correo transaccional (verificación, restablecer contraseña, invitaciones).
# OBLIGATORIO en producción; en desarrollo docker-compose.override.yml apunta a
# Mailpit (http://localhost:18025).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"   # "true" para el puerto 465
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="SundayCRM <no-reply@tudominio.com>"

# Stripe (planes en USD). En desarrollo: llaves de modo prueba y
# `stripe listen --forward-to localhost:15100/api/billing/webhook`, que
# imprime el STRIPE_WEBHOOK_SECRET a usar.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_BASIC=""   # price_... del plan Básico (5 USD/mes)
STRIPE_PRICE_PRO=""     # price_... del plan Pro (10 USD/mes)

# IA de la plataforma: los clientes no configuran keys. Al menos una. Los
# modelos que se ofrecen están en lib/billing/plans.ts → AI_MODELS.
PLATFORM_OPENROUTER_API_KEY=""
PLATFORM_GOOGLE_API_KEY=""
