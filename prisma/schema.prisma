generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  password       String?
  role           String    @default("user")
  maxOpenChats   Int?
  // Usuario desactivado por un admin: no puede iniciar sesión, su sesión
  // vigente se invalida en la siguiente revalidación (lib/auth.ts) y deja de
  // recibir chats por auto-asignación.
  disabledAt     DateTime? @map("disabled_at")
  // Se incrementa para invalidar todas las sesiones JWT ya emitidas del
  // usuario (al desactivarlo) — el token guarda la versión con la que se firmó.
  sessionVersion Int       @default(0) @map("session_version")
  // Espacio de trabajo al que pertenece (un usuario = una organización). role
  // es el rol DENTRO de esta organización.
  organizationId String       @map("organization_id")
  organization   Organization @relation("OrganizationMembers", fields: [organizationId], references: [id], onDelete: Cascade)
  ownedOrganization Organization? @relation("OrganizationOwner")
  // Correo confirmado (enlace de verificación, restablecer contraseña o
  // aceptar una invitación lo prueban). Sin verificar se puede entrar, pero no
  // conectar canales ni pagar.
  emailVerifiedAt   DateTime?     @map("email_verified_at")
  authTokens        AuthToken[]   @relation("AuthTokenUser")
  sentInvitations   AuthToken[]   @relation("AuthTokenInviter")

  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  waAccounts            WAAccount[]
  waCampaigns           WACampaign[]
  waBots                WABot[]
  leadScorerBots        WALeadScorerBot[]
  googleAccount         GoogleAccount?
  sharedAccounts        WAAccountShare[]
  notes                 WANote[]
  assignedChats         WAChat[]               @relation("ChatAssignments")
  notifications         Notification[]
  sentMessages          WAMessage[]
  leadSheetSources      LeadSheetSource[]
  channelAccounts       ChannelAccount[]
  assignedConversations Conversation[]
  sentChannelMessages   ChannelMessage[]
  sharedChannelAccounts ChannelAccountShare[]
  metaAdsAccounts       MetaAdsAccount[]
  appointmentsAssigned  WAAppointment[]        @relation("WAAppointmentAssignee")
  appointmentsCreated   WAAppointment[]        @relation("WAAppointmentCreatedBy")
  routingRuleTargets    WAAccountRoutingRule[]
  sequences             WASequence[]
  apiKeys               ApiKey[]
  webhookEndpoints      WebhookEndpoint[]
  automations           Automation[]
  automationVersions    AutomationVersion[]
  ownedPeople           Person[]               @relation("PersonOwner")
  ownedCompanies        Company[]              @relation("CompanyOwner")
  activityLogs          ActivityLog[]
  savedViews            SavedView[]
  importRuns            ImportRun[]

  @@index([organizationId])
  @@map("users")
}

// Conexión OAuth por usuario a Google (Sheets). A diferencia de WAAccount
// (secretos estáticos que no expiran), accessToken/refreshToken son un par OAuth que
// se refresca en runtime — ver lib/google/sheets-client.ts. Ambos se guardan cifrados
// con lib/crypto.ts, igual que los demás secretos del proyecto.
model GoogleAccount {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  googleEmail          String
  accessToken          String
  refreshToken         String
  accessTokenExpiresAt DateTime
  scope                String
  spreadsheetId        String?
  enabled              Boolean   @default(true)
  lastSyncedAt         DateTime?
  lastSyncError        String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("google_accounts")
}

model WAAccount {
  id                String          @id @default(cuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId    String          @map("organization_id")
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name              String
  channel           WAChannel       @default(META_CLOUD)
  connectionType    WAConnectionType @default(MANUAL) @map("connection_type")
  // Coexistencia: el número sigue activo en la app WhatsApp Business del
  // teléfono además de Cloud API (Embedded Signup con featureType
  // whatsapp_business_app_onboarding).
  coexistence            Boolean                 @default(false)
  syncStatus             WACoexistenceSyncStatus @default(NONE) @map("sync_status")
  syncDeadlineAt         DateTime?               @map("sync_deadline_at")
  syncProgress           Int?                    @map("sync_progress")
  // { contacts?: request_id, history?: request_id } de POST /smb_app_data.
  syncRequestIds         Json?                   @map("sync_request_ids")
  syncError              String?                 @map("sync_error")
  businessAppOnboardedAt DateTime?               @map("business_app_onboarded_at")
  // Token de negocio de Embedded Signup (WAAccount.accessToken): cuándo vence y
  // cuándo se avisó, para no repetir el aviso en cada tick.
  tokenExpiresAt         DateTime?               @map("token_expires_at")
  tokenAlertedAt         DateTime?               @map("token_alerted_at")
  // PIN de 6 dígitos con el que se registró el número en Cloud API (cifrado).
  twoStepPin             String?                 @map("two_step_pin")
  disconnectedReason     String?                 @map("disconnected_reason")
  // Id de Meta de quien autorizó la app, si se pudo obtener: sirve para casar
  // los callbacks de desautorización/eliminación de datos con la cuenta.
  metaUserId             String?                 @map("meta_user_id")
  phoneNumber       String?
  phoneNumberId     String?
  wabaId            String?
  // Meta App ID that owns accessToken — required only for the Resumable Upload
  // API used when creating a template with a media header (distinct from wabaId,
  // which scopes template/message sends). Different WABA accounts can belong to
  // different Meta Apps, so this is per-account rather than a global env var.
  appId             String?
  accessToken       String?
  verifyTokenHash   String?
  appSecret         String?
  status            WaAccountStatus @default(PENDING)
  errorMessage      String?
  lastActivity      DateTime?
  autoAssignEnabled Boolean         @default(false)
  // Reportados por el webhook `phone_number_quality_update` de Meta — no se
  // consultan por API, solo llegan de forma reactiva (push). qualityRating es
  // el valor crudo que manda Meta (p. ej. "GREEN"/"YELLOW"/"RED" o el nombre
  // del evento "FLAGGED"/"UNFLAGGED"); messagingTier es el límite de envío por
  // 24h vigente (p. ej. "TIER_1K"). Ambos null hasta el primer evento recibido.
  qualityRating     String?
  messagingTier     String?
  qualityUpdatedAt  DateTime?
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  chats      WAChat[]
  templates  WATemplate[]
  campaigns  WACampaign[]
  bots       WABot[]
  sharedWith WAAccountShare[]
  contacts   Contact[]

  cannedResponses        CannedResponse[]
  tags                   Tag[]
  leadSheetSources       LeadSheetSource[]
  // Cuentas de Meta Ads (Instant Forms) que entregan sus leads bajo este
  // número — ver MetaAdsAccount.waAccountId.
  metaAdsAccounts        MetaAdsAccount[]
  customFieldDefinitions ContactCustomFieldDefinition[]
  routingRules           WAAccountRoutingRule[]
  sequences              WASequence[]
  automations            Automation[]

  @@unique([phoneNumberId])
  @@unique([userId, name])
  @@index([phoneNumberId])
  @@index([organizationId])
  @@index([syncStatus, syncDeadlineAt])
  @@index([metaUserId])
  @@map("wa_accounts")
}

model CannedResponse {
  id               String          @id @default(cuid())
  waAccountId      String?
  waAccount        WAAccount?      @relation(fields: [waAccountId], references: [id], onDelete: Cascade)
  // Mutuamente excluyente con waAccountId a nivel de aplicación — mismo
  // patrón que WABot.waAccountId/channelAccountId.
  channelAccountId String?
  channelAccount   ChannelAccount? @relation(fields: [channelAccountId], references: [id], onDelete: Cascade)
  shortcut         String
  content          String
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  @@unique([waAccountId, shortcut])
  @@unique([channelAccountId, shortcut])
  @@map("canned_responses")
}

enum ContactCustomFieldType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
}

// Definición de un campo configurable por cuenta — greenfield: Contact tiene
// columnas fijas y ningún precedente de campo dinámico (a diferencia de
// WALeadScore.details, que es un Json deliberadamente no normalizado para
// datos generados por IA). Se modela normalizado, mismo patrón dual
// waAccountId/channelAccountId que CannedResponse, porque definiciones sí
// necesitan listarse/ordenarse/editarse — un blob Json por contacto perdería
// integridad referencial si una definición se borra o renombra su key.
model ContactCustomFieldDefinition {
  id               String                 @id @default(cuid())
  waAccountId      String?
  waAccount        WAAccount?             @relation(fields: [waAccountId], references: [id], onDelete: Cascade)
  channelAccountId String?
  channelAccount   ChannelAccount?        @relation(fields: [channelAccountId], references: [id], onDelete: Cascade)
  // Identificador estable (slug) — no cambia si se edita `label`, así que un
  // valor guardado sigue apuntando al campo correcto aunque se le cambie el
  // nombre visible. Solo se fija al crear (ver contactCustomFieldDefinitionUpdateSchema).
  key              String
  label            String
  type             ContactCustomFieldType @default(TEXT)
  // Solo aplica cuando type = SELECT — lista de opciones válidas.
  options          String[]               @default([])
  required         Boolean                @default(false)
  order            Int                    @default(0)
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  values ContactCustomFieldValue[]

  @@unique([waAccountId, key])
  @@unique([channelAccountId, key])
  @@map("contact_custom_field_definitions")
}

// Valor de un campo para un Contact puntual — @@unique([contactId,
// definitionId]) hace de esto un upsert natural (mismo criterio que
// MetaConversionEvent.@@unique([contactId, leadStatus])), no un log de
// historial. `value` es siempre String — el tipo declarado en la definición
// decide cómo se castea/valida en la UI y en cualquier consumidor futuro
// (export CSV, filtros), no la columna misma.
model ContactCustomFieldValue {
  id           String                       @id @default(cuid())
  contactId    String
  contact      Contact                      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  definitionId String
  definition   ContactCustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  value        String?                      @db.Text
  updatedAt    DateTime                     @updatedAt @map("updated_at")

  @@unique([contactId, definitionId])
  @@index([definitionId])
  @@map("contact_custom_field_values")
}

// Estado de la sincronización inicial de una cuenta conectada por coexistencia
// (contactos + historial de la app WhatsApp Business). Meta da 24 h desde el
// alta para pedirla; cada petición (contactos, historial) solo puede hacerse
// una vez por conexión.
enum WACoexistenceSyncStatus {
  NONE
  PENDING
  CONTACTS_REQUESTED
  HISTORY_REQUESTED
  COMPLETED
  HISTORY_DECLINED
  EXPIRED
  FAILED
}

// De dónde salió un mensaje de WAMessage: API = enviado/recibido por Cloud API
// (lo normal), BUSINESS_APP_ECHO = lo escribió el negocio en la app del
// teléfono (smb_message_echoes), HISTORY = importado del historial de la app.
enum WAMessageOrigin {
  API
  BUSINESS_APP_ECHO
  HISTORY
}

// Cómo se conectó la cuenta: MANUAL = el cliente pegó credenciales de SU app de
// Meta (appSecret propio); EMBEDDED_SIGNUP = alta con Embedded Signup sobre la
// app de plataforma (el webhook se firma con PlatformSettings.metaAppSecret).
enum WAConnectionType {
  MANUAL
  EMBEDDED_SIGNUP
}

enum WAChannel {
  META_CLOUD
}

model WAAccountShare {
  id          String    @id @default(cuid())
  waAccountId String
  waAccount   WAAccount @relation(fields: [waAccountId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([waAccountId, userId])
  @@index([userId])
  @@map("wa_account_shares")
}

enum WaAccountStatus {
  PENDING
  CONNECTED
  ERROR
  DISCONNECTED
}

enum ChatStatus {
  OPEN
  PENDING
  RESOLVED
}

// Canales adicionales a WhatsApp — capa de adaptador deliberadamente
// separada de WAAccount/WAChat/WAMessage: ese esquema es de producción y no
// se toca. ChannelAccount/Conversation/ChannelMessage son tablas genéricas
// (no "TelegramAccount") para que cada canal nuevo las reutilice sin
// rediseño de esquema — Messenger e Instagram (Página-vinculada, comparten
// Page Access Token) son el segundo y tercer canal que las reusan así.
enum Channel {
  TELEGRAM
  MESSENGER
  INSTAGRAM
  // Roadmap P3-f — widget de chat en vivo embebible en el sitio web del
  // cliente. A diferencia de los otros 3, no hay proveedor externo que
  // autentique webhooks: el "proveedor" somos nosotros mismos, y el
  // visitante anónimo se identifica por un token de sesión propio (ver
  // lib/webchat/session-token.ts), no por credenciales de una plataforma.
  WEBCHAT
}

model ChannelAccount {
  id                String          @id @default(cuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId    String          @map("organization_id")
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel           Channel
  name              String
  status            WaAccountStatus @default(PENDING)
  errorMessage      String?
  // JSON encriptado (AES-256-GCM vía lib/crypto.ts, mismo formato que
  // WAAccount.accessToken) con las credenciales del proveedor. Cada canal
  // tiene un shape distinto (Telegram: botToken; Messenger/Instagram:
  // pageAccessToken+appSecret) — un blob evita repetir el patrón de
  // columnas planas por proveedor que WAAccount fue acumulando.
  credentials       String
  // Page ID (Messenger) o IG-scoped Business ID (Instagram), tal como Meta
  // lo reporta en entry[].id del webhook POST de mensajería — permite
  // resolver la cuenta con un findUnique en vez de desencriptar/probar cada
  // fila de `credentials`. Null para Telegram (usa [accountId] en la URL
  // del webhook, no lo necesita).
  externalAccountId String?
  // Hash (no reversible, mismo mecanismo que MetaAdsAccount.verifyTokenHash)
  // del hub.verify_token configurado en el Meta App Dashboard — resuelve el
  // handshake GET del webhook compartido de mensajería, que no trae
  // entry[].id. Null para Telegram (setWebhook no usa este mecanismo).
  verifyTokenHash   String?
  autoAssignEnabled Boolean         @default(false)
  lastActivity      DateTime?
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  conversations          Conversation[]
  contacts               Contact[]
  bots                   WABot[]
  cannedResponses        CannedResponse[]
  tags                   Tag[]
  sharedWith             ChannelAccountShare[]
  customFieldDefinitions ContactCustomFieldDefinition[]
  sequences              WASequence[]
  automations            Automation[]

  @@unique([userId, name])
  // findUnique determinístico en el webhook compartido de Messenger/
  // Instagram: si dos ChannelAccount terminaran apuntando a la misma
  // Página, esto lo rechaza en vez de ocultar la colisión con un findFirst.
  @@unique([channel, externalAccountId])
  @@index([organizationId])
  @@map("channel_accounts")
}

model ChannelAccountShare {
  id               String         @id @default(cuid())
  channelAccountId String
  channelAccount   ChannelAccount @relation(fields: [channelAccountId], references: [id], onDelete: Cascade)
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelAccountId, userId])
  @@index([userId])
  @@map("channel_account_shares")
}

model Conversation {
  id               String         @id @default(cuid())
  channelAccountId String
  channelAccount   ChannelAccount @relation(fields: [channelAccountId], references: [id], onDelete: Cascade)
  externalId       String
  name             String?
  isGroup          Boolean        @default(false)
  contactId        String?        @unique
  contact          Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lastMessage      String?
  lastMessageAt    DateTime?
  unreadCount      Int            @default(0)
  status           ChatStatus     @default(OPEN)
  assignedToId     String?
  assignedTo       User?          @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  resolvedAt       DateTime?
  firstResponseAt  DateTime?
  botResumedAt     DateTime?
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  messages         ChannelMessage[]
  botConversations WABotConversation[]
  automationRuns   AutomationRun[]

  @@unique([channelAccountId, externalId])
  @@index([assignedToId])
  @@index([channelAccountId, lastMessageAt])
  @@map("conversations")
}

model ChannelMessage {
  id                String           @id @default(cuid())
  externalMessageId String?
  conversationId    String
  conversation      Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction         MessageDirection
  messageType       String
  body              String?
  caption           String?
  mediaId           String?
  mediaUrl          String?
  mimeType          String?
  filename          String?
  bytesSize         Int?
  status            String?
  senderId          String?
  sender            User?            @relation(fields: [senderId], references: [id], onDelete: SetNull)
  // Roadmap P3-c — true si este INBOUND vino de un comentario de Facebook
  // Page (webhook `feed`), no de un mensaje directo. `externalMessageId` ya
  // guarda el comment_id de Meta en ese caso (mismo campo, sin columna
  // aparte) — este flag es lo que permite distinguir cuál de los dos
  // significados tiene. Necesario para decidir el mecanismo de envío de la
  // primera respuesta: ver sendMetaChannelReply() en chats/[chatId]/send.
  isFromComment     Boolean          @default(false) @map("is_from_comment")
  // Botones/lista enviados (OUTBOUND) o la opción elegida (INBOUND:
  // { replyId }) — paridad con WAMessage.interactivePayload.
  interactivePayload Json?          @map("interactive_payload")
  timestamp         DateTime
  createdAt         DateTime         @default(now()) @map("created_at")

  @@unique([conversationId, externalMessageId])
  @@index([conversationId, timestamp])
  @@map("channel_messages")
}

model WAChat {
  id              String     @id @default(cuid())
  accountId       String
  account         WAAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  remoteJid       String
  name            String?
  isGroup         Boolean    @default(false)
  lastMessage     String?
  lastMessageAt   DateTime?
  unreadCount     Int        @default(0)
  contactId       String?    @unique
  contact         Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  assignedToId    String?
  assignedTo      User?      @relation("ChatAssignments", fields: [assignedToId], references: [id], onDelete: SetNull)
  status          ChatStatus @default(OPEN)
  resolvedAt      DateTime?
  firstResponseAt DateTime?
  botResumedAt    DateTime?
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  messages         WAMessage[]
  botConversations WABotConversation[]
  automationRuns   AutomationRun[]
  chatTags         ChatTag[]
  leadScores       WALeadScore[]
  recoveryAttempts WALeadRecoveryAttempt[]

  @@unique([accountId, remoteJid])
  @@index([assignedToId])
  @@index([accountId, lastMessageAt])
  @@index([accountId, status])
  @@map("wa_chats")
}

model WALeadScorerBot {
  id                        String    @id @default(cuid())
  userId                    String
  user                      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId   String       @map("organization_id")
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                      String
  provider                  String
  model                     String
  systemPrompt              String    @db.Text
  isActive                  Boolean   @default(true)
  scheduleEnabled           Boolean   @default(false)
  scheduleIntervalMinutes   Int?
  scheduleAccountIds        String[]  @default([])
  // Alcance separado para cuentas de Telegram — WAAccount.id y
  // ChannelAccount.id son cuids de tablas distintas sin garantía de
  // unicidad cruzada; mezclarlos en scheduleAccountIds arriesgaría
  // colisiones silenciosas de id entre canales.
  scheduleChannelAccountIds String[]  @default([])
  lastRunAt                 DateTime?
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  scores WALeadScore[]
  usage  WALeadScorerUsage[]

  @@unique([userId, name])
  @@index([organizationId])
  @@map("wa_lead_scorer_bots")
}

model WALeadScorerUsage {
  id               String          @id @default(cuid())
  scorerId         String
  scorer           WALeadScorerBot @relation(fields: [scorerId], references: [id], onDelete: Cascade)
  waChatId         String?
  // Igual que waChatId: referencia blanda (sin @relation), solo para
  // atribuir el gasto a una conversación de Telegram en el costo por chat.
  conversationId   String?
  model            String
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  estimatedCost    Float
  createdAt        DateTime        @default(now()) @map("created_at")

  @@index([scorerId, createdAt])
  @@map("wa_lead_scorer_usage")
}

model WALeadScore {
  id             String          @id @default(cuid())
  chatId         String?
  chat           WAChat?         @relation(fields: [chatId], references: [id], onDelete: Cascade)
  // Referencia blanda a Conversation (Telegram) — mismo patrón que
  // ChatTag.conversationId / WABotUsage.conversationId.
  conversationId String?
  scorerId       String
  scorer         WALeadScorerBot @relation(fields: [scorerId], references: [id], onDelete: Cascade)
  score          Int
  label          String
  summary        String
  reasons        String
  // Structured extraction beyond score/label (señales de compra, objeciones,
  // próximos pasos, producto de interés, etc.) — kept as a single flexible
  // JSON blob instead of a dozen typed columns since its shape is dictated by
  // the prompt contract in lib/whatsapp/lead-scoring.ts, not by relational
  // needs elsewhere in the schema. Null for scores generated before this field.
  details        Json?
  model          String
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@unique([chatId, scorerId])
  @@unique([conversationId, scorerId])
  @@map("wa_lead_scores")
}

model WAMessage {
  id                 String           @id @default(cuid())
  wamid              String?
  // API = Cloud API; BUSINESS_APP_ECHO = escrito en la app del teléfono del
  // negocio (coexistencia); HISTORY = importado del historial de esa app.
  origin             WAMessageOrigin  @default(API)
  // Contexto de respuesta de WhatsApp: el id externo del mensaje citado.
  replyToWamid       String?
  // Una conversación individual tiene un lead; la reacción vigente de ese
  // lead se muestra sobre el mensaje original, no como mensaje independiente.
  reactionEmoji      String?
  reactionAt         DateTime?
  agentReactionEmoji String?
  agentReactions     WAReaction[]
  chatId             String
  chat               WAChat           @relation(fields: [chatId], references: [id], onDelete: Cascade)
  direction          MessageDirection
  messageType        String
  body               String?
  caption            String?
  mediaId            String?
  mediaUrl           String?
  mimeType           String?
  filename           String?
  bytesSize          Int?
  // Botones de respuesta rápida enviados (outbound) o el id de la respuesta
  // recibida (inbound) para un mensaje interactivo de Meta — ver
  // lib/whatsapp/send-interactive.ts. No existe en ChannelMessage (Telegram),
  // fuera de alcance por ahora.
  interactivePayload Json?
  // Objeto `referral` crudo de Meta (ctwa_clid, source_id, source_type,
  // source_url, ...) cuando este mensaje inbound viene de un anuncio
  // click-to-WhatsApp — guardado para auditoría; la atribución "first-touch"
  // usable (Contact.ctwaClid/adId/leadOrigin) se deriva de este mismo objeto
  // en lib/whatsapp/ingest-message.ts pero solo en el create del Contact.
  referral           Json?
  status             String?
  senderId           String?
  sender             User?            @relation(fields: [senderId], references: [id], onDelete: SetNull)
  campaignId         String?
  campaign           WACampaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  // Igual que campaignId pero para envíos disparados por una fuente de leads
  // externa (LeadSheetSource) — nunca ambos a la vez, cada WAMessage viene de
  // como mucho un origen. Ver lib/whatsapp/chat-attribution.ts para cómo se
  // unifican ambos campos en una sola "atribución" del chat.
  leadSheetSourceId  String?
  leadSheetSource    LeadSheetSource? @relation(fields: [leadSheetSourceId], references: [id], onDelete: SetNull)
  timestamp          DateTime
  createdAt          DateTime         @default(now()) @map("created_at")

  recoveryAttempt WALeadRecoveryAttempt?

  @@unique([chatId, wamid])
  @@index([wamid])
  @@index([chatId, replyToWamid])
  @@index([chatId, timestamp])
  @@index([chatId, direction])
  @@index([campaignId])
  @@index([leadSheetSourceId])
  @@map("wa_messages")
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

// Registra cada mensaje de reactivación enviado a un chat que se quedó
// callado — attemptNumber (1 o 2) + createdAt permiten calcular en qué etapa
// va un chat sin tener que resetear nada manualmente cuando el lead responde:
// solo se cuentan los intentos con createdAt posterior al último INBOUND.
model WAReaction {
  id        String @id @default(cuid())
  messageId String
  message   WAMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  emoji     String
  wamid     String? @unique
  status    String @default("pending")
  error     String?
  senderId  String
  createdAt DateTime @default(now())

  @@index([messageId, createdAt])
  @@map("wa_reactions")
}

model WASticker {
  id             String @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  data           Bytes
  sha256         String
  animated       Boolean @default(false)
  favorite       Boolean @default(false)
  lastUsedAt     DateTime?
  createdAt      DateTime @default(now())

  @@unique([organizationId, sha256])
  @@map("wa_stickers")
}

model WALeadRecoveryAttempt {
  id               String     @id @default(cuid())
  chatId           String?
  chat             WAChat?    @relation(fields: [chatId], references: [id], onDelete: Cascade)
  // Blanda, igual que messageId/channelMessageId más abajo — mutuamente
  // excluyente con chatId a nivel de aplicación (ver ChatTag/CannedResponse
  // para el mismo patrón dual-canal).
  conversationId   String?
  attemptNumber    Int
  messageId        String?    @unique
  message          WAMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  // Blanda, sin @relation — preserva "un intento de recuperación por mensaje
  // enviado" también para Telegram.
  channelMessageId String?    @unique
  model            String
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  estimatedCost    Float
  createdAt        DateTime   @default(now()) @map("created_at")

  @@index([chatId, createdAt])
  @@index([conversationId, createdAt])
  @@map("wa_lead_recovery_attempts")
}

model WATemplate {
  id          String    @id @default(cuid())
  waAccountId String
  waAccount   WAAccount @relation(fields: [waAccountId], references: [id], onDelete: Cascade)
  templateId  String
  name        String
  language    String
  category    String
  status      String
  components  Json
  syncedAt    DateTime  @default(now())
  createdAt   DateTime  @default(now()) @map("created_at")

  campaigns        WACampaign[]
  leadSheetSources LeadSheetSource[]

  @@unique([waAccountId, templateId])
  @@map("wa_templates")
}

// Fuente de leads externa (hoja de Google Sheets, típicamente alimentada por la
// sincronización nativa de Facebook Lead Ads → Sheets). A diferencia de GoogleAccount
// (una hoja por usuario, la que la app crea para exportar), spreadsheetId aquí es una hoja
// arbitraria del usuario — la misma conexión OAuth (lib/google/sheets-client.ts) sirve
// para leerla porque el scope otorgado no está restringido a los archivos creados por la app.
model LeadSheetSource {
  id                String     @id @default(cuid())
  userId            String
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId   String       @map("organization_id")
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  waAccountId       String
  waAccount         WAAccount  @relation(fields: [waAccountId], references: [id], onDelete: Cascade)
  waTemplateId      String
  waTemplate        WATemplate @relation(fields: [waTemplateId], references: [id], onDelete: Cascade)
  name              String
  spreadsheetId     String
  sheetName         String
  phoneColumn       String
  nameColumn        String?
  // Nombres de columna de la hoja, en el orden {{1}},{{2}},... del body de la plantilla.
  bodyColumns       Json
  // Igual que WACampaign.headerParam/buttonParam: valores estáticos (no por fila) —
  // texto o Meta media id para el header, sufijo de URL para el botón dinámico.
  headerParam       String?
  buttonParam       String?
  enabled           Boolean    @default(true)
  lastRunAt         DateTime?
  lastImportedCount Int        @default(0)
  lastError         String?
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  importedRows LeadSheetImportedRow[]
  messages     WAMessage[]

  @@index([userId])
  @@index([waAccountId])
  @@index([organizationId])
  @@map("lead_sheet_sources")
}

// Log de deduplicación: una fila por (fuente, teléfono) ya vista, para no volver
// a disparar la plantilla al mismo lead en ticks futuros. "seeded" = fila que ya
// existía en la hoja al conectar la fuente (se ignora salvo import manual explícito).
model LeadSheetImportedRow {
  id           String          @id @default(cuid())
  sourceId     String
  source       LeadSheetSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  phoneNumber  String
  contactName  String?
  // status: "sent" | "delivered" | "read" | "failed" | "skipped" | "seeded" —
  // delivered/read los pone el webhook de Meta (ver applyStatusUpdate), igual
  // que en WACampaignRecipient.
  status       String
  wamid        String?
  deliveredAt  DateTime?
  readAt       DateTime?
  errorMessage String?
  importedAt   DateTime        @default(now())

  @@unique([sourceId, phoneNumber])
  @@index([wamid])
  @@map("lead_sheet_imported_rows")
}

model WACampaign {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId   String       @map("organization_id")
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  waAccountId    String
  waAccount      WAAccount      @relation(fields: [waAccountId], references: [id], onDelete: Cascade)
  waTemplateId   String
  waTemplate     WATemplate     @relation(fields: [waTemplateId], references: [id], onDelete: Cascade)
  name           String
  status         CampaignStatus @default(DRAFT)
  // Global values applied to every recipient — unlike body parameters (per-recipient,
  // see WACampaignRecipient.parameters), header text/media and button URL suffixes are
  // the same for the whole campaign in WhatsApp's template model.
  headerParam    String?
  buttonParam    String?
  scheduledAt    DateTime?
  sentAt         DateTime?
  completedAt    DateTime?
  recipientCount Int            @default(0)
  sentCount      Int            @default(0)
  deliveredCount Int            @default(0)
  readCount      Int            @default(0)
  failedCount    Int            @default(0)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  recipients WACampaignRecipient[]
  messages   WAMessage[]

  @@index([userId])
  @@index([waAccountId])
  @@index([organizationId])
  @@map("wa_campaigns")
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  COMPLETED
  FAILED
}

model WACampaignRecipient {
  id           String          @id @default(cuid())
  campaignId   String
  campaign     WACampaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  phoneNumber  String
  contactName  String?
  wamid        String?
  parameters   Json?
  status       RecipientStatus @default(PENDING)
  errorMessage String?
  sentAt       DateTime?
  deliveredAt  DateTime?
  readAt       DateTime?

  @@index([wamid])
  @@index([campaignId, status])
  @@map("wa_campaign_recipients")
}

enum RecipientStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

model WABot {
  id                           String          @id @default(cuid())
  userId                       String
  user                         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId   String       @map("organization_id")
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  waAccountId                  String?
  waAccount                    WAAccount?      @relation(fields: [waAccountId], references: [id], onDelete: SetNull)
  // Mutuamente excluyente con waAccountId a nivel de aplicación — un bot sirve
  // a una cuenta de WhatsApp o a una cuenta de canal (Telegram), nunca ambas.
  channelAccountId             String?
  channelAccount               ChannelAccount? @relation(fields: [channelAccountId], references: [id], onDelete: SetNull)
  name                         String
  provider                     String
  model                        String
  systemPrompt                 String          @db.Text
  temperature                  Float           @default(0.7)
  maxTokens                    Int             @default(1024)
  memoryType                   BotMemoryType   @default(RECENT)
  memoryLimit                  Int             @default(20)
  ragEnabled                   Boolean         @default(false)
  humanizeEnabled              Boolean         @default(false)
  // Opt-in — Fase 2 de Citas (roadmap P1). Cuando está activo, bot-worker.ts
  // agrega el contrato de marcador estructurado (lib/ai/appointment-marker.ts)
  // para que el bot pueda proponer/agendar una WAAppointment (source: AI_BOT)
  // cuando el lead confirma fecha/hora en la conversación. Default false para
  // no cambiar el comportamiento de bots existentes ni el costo en tokens.
  appointmentSchedulingEnabled Boolean         @default(false)
  isActive                     Boolean         @default(false)
  status                       BotStatus       @default(ACTIVE)
  createdAt                    DateTime        @default(now()) @map("created_at")
  updatedAt                    DateTime        @updatedAt @map("updated_at")

  conversations WABotConversation[]
  knowledgeBots WABotKnowledgeBot[]
  usage         WABotUsage[]

  @@unique([userId, name])
  @@index([organizationId])
  @@map("wa_bots")
}

enum BotMemoryType {
  NONE
  RECENT
  SUMMARY
}

enum BotStatus {
  ACTIVE
  ERROR
}

model WABotConversation {
  id             String        @id @default(cuid())
  botId          String
  bot            WABot         @relation(fields: [botId], references: [id], onDelete: Cascade)
  // waChatId/conversationId son mutuamente excluyentes según el tipo de bot
  // (ver WABot.waAccountId/channelAccountId) — ambos opcionales para permitir
  // el historial de un bot sirviendo a Telegram sin FK a WAChat.
  waChatId       String?
  waChat         WAChat?       @relation(fields: [waChatId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  summary        String?       @db.Text

  @@unique([botId, waChatId])
  @@unique([botId, conversationId])
  @@map("wa_bot_conversations")
}

model WABotKnowledge {
  id         String                     @id @default(cuid())
  title      String
  content    String                     @db.Text
  embedding  Unsupported("vector(768)")
  chunkIndex Int
  sourceName String?
  createdAt  DateTime                   @default(now()) @map("created_at")

  bots WABotKnowledgeBot[]

  @@map("wa_bot_knowledge")
}

model WABotKnowledgeBot {
  knowledgeId String
  botId       String
  knowledge   WABotKnowledge @relation(fields: [knowledgeId], references: [id], onDelete: Cascade)
  bot         WABot          @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@id([knowledgeId, botId])
  @@index([botId])
  @@map("wa_bot_knowledge_bots")
}

model WABotUsage {
  id               String   @id @default(cuid())
  botId            String
  bot              WABot    @relation(fields: [botId], references: [id], onDelete: Cascade)
  waChatId         String?
  // Igual que waChatId: referencia "blanda" (sin @relation), solo para
  // atribuir el gasto a una conversación de Telegram en el costo por chat.
  conversationId   String?
  model            String
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  estimatedCost    Float
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([botId, createdAt])
  @@map("wa_bot_usage")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CUSTOMER
  LOST
}

model Contact {
  id                String          @id @default(cuid())
  // accountId/channelAccountId son mutuamente excluyentes (a nivel de
  // aplicación, no de constraint DB): un Contact viene de WhatsApp o de un
  // canal genérico (Telegram por ahora), nunca de ambos. Ambos opcionales en
  // vez de una FK polimórfica real porque Prisma no soporta esa relación de
  // forma nativa — mismo patrón ya usado en WABot.waAccountId/channelAccountId.
  accountId         String?
  account           WAAccount?      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  channelAccountId  String?
  channelAccount    ChannelAccount? @relation(fields: [channelAccountId], references: [id], onDelete: Cascade)
  remoteJid         String
  name              String?
  // Nombre aprendido por un calificador de IA durante la conversación (campo
  // details.nombre_real de WALeadScore) — distinto de `name`, que viene del
  // CSV/hoja de origen (revisado por marketing) y nunca se pisa con esto.
  // Null hasta que algún calificador detecte un nombre real.
  realName          String?
  leadStatus        LeadStatus      @default(NEW)
  // Reportado por el webhook `user_preferences` de Meta cuando el lead usa el
  // mecanismo nativo de WhatsApp para darse de baja de mensajes de marketing
  // (category "marketing_messages", value "stop"/"resume"). campaign-worker.ts
  // excluye a estos contactos de futuros envíos de campaña — no afecta
  // respuestas manuales/bot en un chat ya iniciado por el lead.
  optedOutMarketing Boolean         @default(false)
  optedOutAt        DateTime?
  // Atribución a un anuncio de Meta, capturada "first-touch": se setea solo al
  // crear el Contact (nunca en updates posteriores, mismo principio que
  // realName) para que un segundo touch no pise el origen real del lead.
  // ORGANIC (default) = sin anuncio detectado, no se reporta a Meta.
  leadOrigin        LeadOrigin      @default(ORGANIC)
  // Id de 15-17 dígitos que Meta asigna a un lead de Instant Form — requerido
  // para reportar "Conversion Leads". Solo presente si leadOrigin=INSTANT_FORM.
  metaLeadId        String?
  // ctwa_clid del objeto `referral` en el primer mensaje entrante de un
  // anuncio click-to-WhatsApp — solo presente si leadOrigin=CTWA. Ver
  // lib/whatsapp/ingest-message.ts.
  ctwaClid          String?
  // source_id (Instant Form) o ad_id (CTWA) del anuncio de origen, si Meta lo
  // reportó — informativo, no se usa para el envío de eventos.
  adId              String?
  // Solo se fija para leadOrigin=INSTANT_FORM (el webhook leadgen sabe
  // literalmente de qué Página vino el lead, first-touch). Para CTWA queda
  // null a propósito: no hay Página involucrada en ese flujo, así que
  // lib/meta/send-conversion.ts resuelve la MetaAdsAccount dinámicamente por
  // waAccountId al momento de mandar el evento, en vez de congelarla aquí.
  metaAdsAccountId  String?
  metaAdsAccount    MetaAdsAccount? @relation(fields: [metaAdsAccountId], references: [id], onDelete: SetNull)
  // La PERSONA real detrás de esta identidad de canal ("Contacto" en la
  // interfaz). Un Contact es una identidad por canal/cuenta; una Person puede
  // tener varias (WhatsApp + Instagram + web…). Siempre existe: la crea
  // lib/contacts/resolve.ts junto con el Contact. Borrar una Person borra sus
  // Contact (cascada) — por eso se borra con lib/crm/people.ts, que antes
  // elimina chats y media.
  personId          String
  person            Person          @relation(fields: [personId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  chat                 WAChat?
  conversation         Conversation?
  tags                 ContactTag[]
  notes                WANote[]
  appointments         WAAppointment[]
  metaConversionEvents MetaConversionEvent[]
  customFieldValues    ContactCustomFieldValue[]
  sequenceEnrollments  WASequenceEnrollment[]
  automationRuns       AutomationRun[]

  @@unique([accountId, remoteJid])
  @@unique([channelAccountId, remoteJid])
  @@index([accountId, leadStatus])
  @@index([channelAccountId, leadStatus])
  // Listados de contactos: orden por actividad reciente dentro del alcance de
  // cuentas (WhatsApp o canal genérico).
  @@index([accountId, updatedAt(sort: Desc)])
  @@index([channelAccountId, updatedAt(sort: Desc)])
  @@index([personId])
  // Un Contact de Instant Form nace sin `chat` (no ha escrito por WhatsApp
  // todavía) bajo el `waAccountId` vinculado en su MetaAdsAccount — este
  // índice soporta el reporte de "leads de Instant Form sin conversación
  // asociada tras N días", la señal barata de detección de drift de teléfono
  // (ver plan de Fase 1: el phone_number de Meta a veces no coincide dígito a
  // dígito con el remoteJid real que después llega por el webhook de
  // mensajes — no se resuelve con un merge automático en esta fase).
  @@index([metaAdsAccountId, leadOrigin])
  @@map("contacts")
}

enum LeadOrigin {
  ORGANIC
  INSTANT_FORM
  CTWA
}

enum MetaEventStatus {
  PENDING
  SENT
  FAILED
}

enum MetaAdsAccountMode {
  // Solo manda eventos con `test_event_code` — visibles en la pestaña "Test
  // Events" de Events Manager, sin afectar la optimización real del ad
  // account. Default: nunca se manda nada "en el aire" sin uno de los dos
  // modos explícitamente confirmado por un admin.
  TEST
  LIVE
}

enum PersonLifecycle {
  LEAD
  CUSTOMER
}

enum SavedViewEntity {
  PEOPLE
  COMPANIES
}

// Persona real ("Contacto" en la interfaz): el perfil unificado de un cliente
// o prospecto en toda la organización, sin importar por cuántos canales escriba.
// Los canales cuelgan de ella como `Contact` (identidad por cuenta/canal).
// Directorio compartido de la organización: `organizationId` es el alcance.
model Person {
  id             String          @id @default(cuid())
  organizationId String          @map("organization_id")
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  // Siempre en minúsculas (coincidencia y deduplicación).
  email          String?
  // Teléfono tal como se mostró/capturó, y su forma de solo dígitos para
  // buscar y detectar duplicados (52…/521… se tratan como el mismo móvil).
  phone          String?
  phoneDigits    String?         @map("phone_digits")
  jobTitle       String?         @map("job_title")
  companyId      String?         @map("company_id")
  company        Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  // Responsable comercial de la persona (no es el asignado del chat).
  ownerId        String?         @map("owner_id")
  owner          User?           @relation("PersonOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  lifecycle      PersonLifecycle @default(LEAD)
  // Cómo llegó: "manual", "import", "api", "whatsapp", "instagram"…
  source         String?
  // Concurrencia optimista: toda edición manda la versión que vio.
  version        Int             @default(1)
  archivedAt     DateTime?       @map("archived_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  contacts     Contact[]
  activityLogs ActivityLog[]

  @@index([organizationId, archivedAt, updatedAt(sort: Desc)])
  @@index([organizationId, phoneDigits])
  @@index([organizationId, email])
  @@index([organizationId, ownerId])
  @@index([companyId])
  @@map("people")
}

// Empresa (B2B): opcional, agrupa personas.
model Company {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  domain         String?
  industry       String?
  size           String?
  location       String?
  notes          String?      @db.Text
  ownerId        String?      @map("owner_id")
  owner          User?        @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  version        Int          @default(1)
  archivedAt     DateTime?    @map("archived_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  people       Person[]
  activityLogs ActivityLog[]

  @@index([organizationId, archivedAt, name])
  @@index([organizationId, ownerId])
  @@map("companies")
}

// Historial CRM de una persona/empresa (creación, cambios de campos, de
// responsable, fusiones, archivo). Se escribe en la MISMA transacción que el
// cambio. Los mensajes, notas y citas no se duplican aquí: la línea de tiempo
// los lee de sus tablas.
model ActivityLog {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  personId       String?      @map("person_id")
  person         Person?      @relation(fields: [personId], references: [id], onDelete: Cascade)
  companyId      String?      @map("company_id")
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actorId        String?      @map("actor_id")
  actor          User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  type           String
  data           Json?
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([organizationId, personId, createdAt(sort: Desc)])
  @@index([organizationId, companyId, createdAt(sort: Desc)])
  @@map("activity_logs")
}

// Vista guardada de un listado (filtros + orden), personal o compartida.
model SavedView {
  id             String          @id @default(cuid())
  organizationId String          @map("organization_id")
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String          @map("user_id")
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  entity         SavedViewEntity
  name           String
  filters        Json
  shared         Boolean         @default(false)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@index([organizationId, entity])
  @@map("saved_views")
}

// Una importación CSV ya aplicada: la huella (archivo + mapeo) impide
// importar dos veces el mismo archivo.
model ImportRun {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String       @map("user_id")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  fingerprint    String
  summary        Json
  createdAt      DateTime     @default(now()) @map("created_at")

  @@unique([organizationId, fingerprint])
  @@map("import_runs")
}

// Config de una Página/Business de Meta Ads para el feedback loop de
// calificación de leads (Conversions API). Deliberadamente separado de
// WAAccount: una Página de Lead Ads no es un número de WhatsApp — puede
// alimentar leads a un número existente (waAccountId) sin ser uno.
model MetaAdsAccount {
  id              String             @id @default(cuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId   String       @map("organization_id")
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  // Id de la Página de Facebook que recibe leadgen — clave para resolver a
  // qué MetaAdsAccount pertenece cada notificación del webhook `leadgen`.
  pageId          String             @unique
  // Token de la Página, usado para el GET a /{leadgen_id}?fields=field_data.
  pageAccessToken String?
  // Secreto de la app de Business, para validar x-hub-signature-256 del
  // webhook leadgen — mismo mecanismo que WAAccount.appSecret.
  appSecret       String?
  verifyTokenHash String?
  // Dataset ID (a veces llamado Pixel ID) de destino de la Conversions API.
  datasetId       String?
  // Access token con permiso sobre ese dataset para /{datasetId}/events.
  capiAccessToken String?
  // Bajo qué número de WhatsApp se crean los Contact de Instant Forms de esta
  // página, antes de que exista cualquier conversación real — ver
  // app/api/meta/webhook/leadgen/route.ts. Null = la ingesta de Instant Forms
  // descarta el evento (no hay dónde crear el Contact).
  waAccountId     String?
  waAccount       WAAccount?         @relation(fields: [waAccountId], references: [id], onDelete: SetNull)
  status          WaAccountStatus    @default(PENDING)
  errorMessage    String?
  mode            MetaAdsAccountMode @default(TEST)
  // Requerido mientras mode=TEST — lib/meta/conversions.ts rechaza mandar un
  // evento si no hay testEventCode NI mode=LIVE confirmado.
  testEventCode   String?
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  contacts         Contact[]
  conversionEvents MetaConversionEvent[]

  @@unique([userId, name])
  @@index([organizationId])
  @@map("meta_ads_accounts")
}

// Log de cada evento de calificación enviado (o intentado) a la Conversions
// API — idempotencia (no reenviar el mismo estado dos veces) y auditoría de
// qué se le mandó a Meta y cuándo. unique([contactId, leadStatus]) se
// resuelve con upsert: si un contacto vuelve a pasar por el mismo estado
// (QUALIFIED -> LOST -> QUALIFIED), el segundo evento sí se reenvía,
// reseteando status a PENDING en vez de quedar bloqueado por el constraint.
model MetaConversionEvent {
  id               String          @id @default(cuid())
  contactId        String
  contact          Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  metaAdsAccountId String
  metaAdsAccount   MetaAdsAccount  @relation(fields: [metaAdsAccountId], references: [id], onDelete: Cascade)
  leadStatus       LeadStatus
  eventName        String
  // event_id enviado a Meta para que su lado pueda deduplicar si se reintenta.
  metaEventId      String          @default(cuid())
  status           MetaEventStatus @default(PENDING)
  errorMessage     String?
  sentAt           DateTime?
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  @@unique([contactId, leadStatus])
  @@index([status])
  @@map("meta_conversion_events")
}

model Tag {
  id               String          @id @default(cuid())
  // Alcance por cuenta — exactamente uno de los dos (a nivel de aplicación),
  // mismo patrón que CannedResponse. Hasta 2026-09-16 el catálogo era global
  // con `name @unique`: cualquier usuario veía las etiquetas (y los nombres de
  // campañas, vía "Campaña: X") de todos los demás clientes, y un nombre usado
  // por una empresa quedaba bloqueado para las demás.
  waAccountId      String?
  waAccount        WAAccount?      @relation(fields: [waAccountId], references: [id], onDelete: Cascade)
  channelAccountId String?
  channelAccount   ChannelAccount? @relation(fields: [channelAccountId], references: [id], onDelete: Cascade)
  name             String
  color            String          @default("accent")
  createdAt        DateTime        @default(now()) @map("created_at")

  contacts ContactTag[]
  chats    ChatTag[]

  @@unique([waAccountId, name])
  @@unique([channelAccountId, name])
  @@map("tags")
}

model ContactTag {
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@index([tagId])
  @@map("contact_tags")
}

model ChatTag {
  id             String   @id @default(cuid())
  chatId         String?
  chat           WAChat?  @relation(fields: [chatId], references: [id], onDelete: Cascade)
  // Referencia blanda a Conversation (Telegram) — igual patrón que
  // WABotUsage.conversationId, sin @relation. Mutuamente excluyente con
  // chatId a nivel de aplicación.
  conversationId String?
  tagId          String
  tag            Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([chatId, tagId])
  @@unique([conversationId, tagId])
  @@index([tagId])
  @@map("chat_tags")
}

model WANote {
  id        String   @id @default(cuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@index([contactId, createdAt])
  @@map("wa_notes")
}

enum WAAppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

// Distingue una cita creada a mano por un agente de una propuesta generada
// por el bot de IA durante una conversación (fase 2, no incluida en el MVP)
// — mismo criterio que Contact.leadOrigin: marca "cómo nació este registro".
enum WAAppointmentSource {
  MANUAL
  AI_BOT
}

// Cita/agenda ligada a un Contact — no a un WAChat/Conversation directamente:
// esa relación ya existe 1:1 vía Contact.chat/Contact.conversation, así que
// repetirla aquí sería redundante (a diferencia de ChatTag, que sí necesita
// su propia referencia porque una etiqueta no está anclada a un contacto).
model WAAppointment {
  id        String  @id @default(cuid())
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  title           String
  notes           String?             @db.Text
  scheduledAt     DateTime            @map("scheduled_at")
  durationMinutes Int                 @default(30) @map("duration_minutes")
  status          WAAppointmentStatus @default(SCHEDULED)
  source          WAAppointmentSource @default(MANUAL)

  assignedToId String?
  assignedTo   User?   @relation("WAAppointmentAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById  String
  createdBy    User    @relation("WAAppointmentCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  // Referencia blanda al WAMessage/ChannelMessage del que se originó la cita
  // (relevante sobre todo para citas de source=AI_BOT, fase 2) — sin
  // @relation, mismo patrón de tolerancia que ChatTag.conversationId: nada
  // cascadea ni se bloquea si el mensaje de origen se pierde.
  originMessageId String?

  reminderMinutesBefore Int       @default(60) @map("reminder_minutes_before")
  // Marca que ya se le mandó el recordatorio — una sola pasada, no una
  // secuencia de intentos como WALeadRecoveryAttempt, así que basta un
  // timestamp en vez de una tabla de intentos aparte.
  remindedAt            DateTime? @map("reminded_at")
  cancelReason          String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([contactId, scheduledAt])
  @@index([assignedToId, scheduledAt])
  // Consultado por el tick de recordatorios cada 5 min sobre TODAS las citas
  // pendientes — este índice compuesto es el que importa para esa query.
  @@index([status, scheduledAt, remindedAt])
  @@map("wa_appointments")
}

// Roadmap P3-d (docs/ROADMAP_PANCAKE.md) — enrutamiento inteligente por
// atributo/score en vez de solo por carga. Reglas simples ordenadas
// ("if-this-then-assign-that"), no un builder visual: `autoAssignChat()`
// evalúa esta lista en orden y, en el primer match, asigna directo al
// usuario de la regla en vez de correr el balanceo por carga — igual que
// respond.io/HubSpot enrutan por VIP/atributo antes de repartir por round-robin.
model WAAccountRoutingRule {
  id          String    @id @default(cuid())
  waAccountId String
  waAccount   WAAccount @relation(fields: [waAccountId], references: [id], onDelete: Cascade)
  // Orden de evaluación — el primer match gana, así que una regla más
  // específica (ej. una etiqueta "VIP") normalmente debe ir antes que una
  // más genérica (ej. leadOrigin CTWA). Se asigna al crear como
  // "al final de la lista actual"; no hay endpoint de reorden en esta
  // primera versión (borrar y volver a crear cubre el caso de uso).
  order       Int       @default(0)

  conditionType  RoutingConditionType
  // Valor a comparar contra la señal en vivo del chat/contacto en el momento
  // de la auto-asignación: un Tag.id (TAG), un valor de LeadOrigin como
  // string (LEAD_ORIGIN), o un label de WALeadScore como string
  // (SCORE_LABEL) — se guarda como texto en vez de 3 FKs opcionales
  // distintas porque solo una aplica según conditionType.
  conditionValue String

  assignedToId String
  assignedTo   User   @relation(fields: [assignedToId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([waAccountId, order])
  @@map("wa_account_routing_rules")
}

enum RoutingConditionType {
  TAG
  LEAD_ORIGIN
  SCORE_LABEL
}

// Roadmap P3-a — secuencias de automatización lineales (sin ramas
// condicionales, decisión de producto 2026-08-06): un trigger dispara la
// inscripción de un Contact, y un tick de BullMQ (lib/workers/sequence-worker.ts)
// va enviando cada WASequenceStep en orden respetando su delay. A propósito
// NO hay condicionales por paso ni bifurcaciones — la única "salida
// temprana" es exitOnReply (ver WASequence.exitOnReply), igual de simple que
// el builder visual completo que ofrecen Botcake/respond.io/HubSpot (ver
// docs/ROADMAP_PANCAKE.md → "P3-a"), que queda deliberadamente fuera de esta
// primera versión.
enum SequenceTriggerType {
  // triggerValue = Tag.id — dispara al agregar esa etiqueta a un Contact.
  TAG_ADDED
  // triggerValue = valor de LeadStatus (como string) — dispara cuando
  // Contact.leadStatus cambia A ese valor.
  LEAD_STATUS_CHANGED
  // triggerValue = null (ignorado) — dispara cuando una WAAppointment del
  // contacto pasa a status COMPLETED.
  APPOINTMENT_COMPLETED
}

enum SequenceEnrollmentStatus {
  ACTIVE
  COMPLETED
  // El contacto respondió (mensaje INBOUND) mientras la secuencia corría y
  // exitOnReply estaba activo — se detuvo antes de mandar el siguiente paso.
  EXITED_REPLY
  CANCELLED
  // El envío del paso actual falló SEQUENCE_MAX_SEND_ATTEMPTS veces seguidas
  // (token inválido, número bloqueado, bot de Telegram removido...) — antes se
  // reintentaba cada 5 minutos para siempre.
  FAILED
  // WhatsApp: el paso no se pudo enviar por la ventana de 24h de Meta y ya no
  // puede reabrirse (exitOnReply: la única forma de reabrirla es que el lead
  // responda, lo que detiene la secuencia) o se agotó el plazo de espera.
  EXPIRED
}

model WASequence {
  id               String          @id @default(cuid())
  // Mutuamente excluyente a nivel de aplicación — mismo patrón dual que
  // CannedResponse/WABot. Alcance WhatsApp + Telegram únicamente (igual que
  // lead scoring/copiloto de IA): Messenger/Instagram quedan fuera por ahora.
  waAccountId      String?
  waAccount        WAAccount?      @relation(fields: [waAccountId], references: [id], onDelete: Cascade)
  channelAccountId String?
  channelAccount   ChannelAccount? @relation(fields: [channelAccountId], references: [id], onDelete: Cascade)

  name         String
  active       Boolean             @default(true)
  triggerType  SequenceTriggerType
  // Ver comentario por valor en SequenceTriggerType — null solo para
  // APPOINTMENT_COMPLETED.
  triggerValue String?
  // Decisión de producto 2026-08-06: encendido por defecto — evita seguir
  // mandando pasos guionados a un contacto que ya está en conversación
  // activa. Configurable por secuencia porque no todas las secuencias tienen
  // el mismo riesgo de sonar robotizadas si se completan de corrido.
  exitOnReply  Boolean             @default(true)

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  organizationId   String       @map("organization_id")
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  steps       WASequenceStep[]
  enrollments WASequenceEnrollment[]

  @@index([waAccountId, triggerType, active])
  @@index([channelAccountId, triggerType, active])
  @@index([organizationId])
  @@map("wa_sequences")
}

model WASequenceStep {
  id           String     @id @default(cuid())
  sequenceId   String
  sequence     WASequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  // 0-based, define tanto el orden de envío como a qué paso apunta
  // WASequenceEnrollment.currentStep.
  order        Int
  delayMinutes Int        @default(0) @map("delay_minutes")
  message      String     @db.Text

  @@unique([sequenceId, order])
  @@map("wa_sequence_steps")
}

model WASequenceEnrollment {
  id         String     @id @default(cuid())
  sequenceId String
  sequence   WASequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  contactId  String
  contact    Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)

  status         SequenceEnrollmentStatus @default(ACTIVE)
  // Índice (0-based) del próximo WASequenceStep.order a enviar — no "el
  // último enviado", para que 0 sea válido antes de que se mande el primero.
  currentStep    Int                      @default(0) @map("current_step")
  // Cuándo debe correr el próximo paso — null solo si status ya no es ACTIVE.
  nextRunAt      DateTime?                @map("next_run_at")
  // Marca de tiempo del último paso mandado — la ventana que
  // exitOnReply usa para buscar un INBOUND posterior; null antes de mandar
  // el primer paso (en ese caso se compara contra enrolledAt).
  lastStepSentAt DateTime?                @map("last_step_sent_at")
  // Intentos fallidos consecutivos de envío del paso actual — vuelve a 0 al
  // enviar un paso. Al llegar al máximo la inscripción pasa a FAILED.
  sendAttempts   Int                      @default(0) @map("send_attempts")
  lastError      String?                  @map("last_error") @db.Text
  enrolledAt     DateTime                 @default(now()) @map("enrolled_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")

  // Un contacto se inscribe como máximo una vez por secuencia — si el
  // trigger vuelve a cumplirse (p. ej. se quita y se vuelve a agregar el
  // mismo tag) no se genera una segunda inscripción ni se reinicia esta.
  // Simplificación deliberada de esta primera versión (ver comentario de
  // SequenceTriggerType) para no arriesgar espamear al mismo contacto.
  @@unique([sequenceId, contactId])
  @@index([status, nextRunAt])
  @@map("wa_sequence_enrollments")
}

enum NotificationType {
  CHAT_MESSAGE
  CAMPAIGN_COMPLETED
  CAMPAIGN_FAILED
  BOT_ERROR
  BUDGET_EXCEEDED
  // Meta reportó un cambio relevante en la cuenta vía webhook: restricción/baneo
  // (account_update) o baja de calidad/límite de envío (phone_number_quality_update).
  ACCOUNT_STATUS
  APPOINTMENT_REMINDER
  // El bot de IA creó una WAAppointment (source: AI_BOT) de forma autónoma
  // tras detectar confirmación de fecha/hora en la conversación — distinta de
  // APPOINTMENT_REMINDER (que avisa de una cita YA agendada, sin importar
  // quién la creó, cerca de su hora).
  APPOINTMENT_PROPOSED
  // Una integración saliente (webhook) se desactivó sola tras fallar seguido.
  INTEGRATION_ERROR
  // Prueba por vencer, pago fallido, solo lectura, límite del plan alcanzado.
  BILLING
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([userId, read, createdAt])
  @@map("notifications")
}

// ─── API pública, webhooks salientes ────────────────────────────────────────
// API key de la API pública (/api/v1) y del servidor MCP. Solo un admin las
// crea; la key actúa con el alcance de su dueño (getUserAccountIds +
// getUserChannelAccountIds), opcionalmente recortado a `accountIds`/
// `channelAccountIds`. El secreto nunca se guarda: solo su sha256 (hashToken),
// y se muestra una única vez al crearla — mismo criterio que verifyTokenHash.
model ApiKey {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId   String       @map("organization_id")
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name              String
  // Primeros caracteres visibles ("sk_live_ab12") para reconocerla en la lista.
  prefix            String
  keyHash           String    @unique @map("key_hash")
  scopes            String[]  @default([])
  // Vacíos = todas las cuentas a las que el dueño tiene acceso.
  accountIds        String[]  @default([]) @map("account_ids")
  channelAccountIds String[]  @default([]) @map("channel_account_ids")
  lastUsedAt        DateTime? @map("last_used_at")
  expiresAt         DateTime? @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([organizationId])
  @@map("api_keys")
}

// Destino de webhooks salientes: cada evento de dominio (lib/events) que
// coincide con `events` y el alcance de cuentas se entrega firmado con HMAC
// (X-Colibly-Signature) por la cola webhook-deliveries.
model WebhookEndpoint {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId   String       @map("organization_id")
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                String
  url                 String
  // Secreto de firma, cifrado con lib/crypto.ts (se muestra al crearlo y se
  // puede rotar, nunca se devuelve en claro después).
  secret              String
  events              String[]  @default([])
  accountIds          String[]  @default([]) @map("account_ids")
  channelAccountIds   String[]  @default([]) @map("channel_account_ids")
  active              Boolean   @default(true)
  consecutiveFailures Int       @default(0) @map("consecutive_failures")
  // Se desactiva solo tras WEBHOOK_MAX_CONSECUTIVE_FAILURES fallos seguidos.
  disabledAt          DateTime? @map("disabled_at")
  lastDeliveryAt      DateTime? @map("last_delivery_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  deliveries WebhookDelivery[]

  @@index([userId, active])
  @@index([organizationId])
  @@map("webhook_endpoints")
}

enum WebhookDeliveryStatus {
  PENDING
  SENT
  FAILED
}

model WebhookDelivery {
  id           String                @id @default(cuid())
  endpointId   String                @map("endpoint_id")
  endpoint     WebhookEndpoint       @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  eventId      String                @map("event_id")
  eventType    String                @map("event_type")
  payload      Json
  status       WebhookDeliveryStatus @default(PENDING)
  attempts     Int                   @default(0)
  responseCode Int?                  @map("response_code")
  error        String?               @db.Text
  createdAt    DateTime              @default(now()) @map("created_at")
  deliveredAt  DateTime?             @map("delivered_at")

  @@unique([endpointId, eventId])
  @@index([endpointId, createdAt])
  @@index([createdAt])
  @@map("webhook_deliveries")
}

// ─── Automatizaciones (motor único: flujos con botones, reglas y secuencias) ──
// El grafo es un árbol JSON (lib/automations/types.ts). Se edita en
// draftGraph; publicar crea una AutomationVersion inmutable y las ejecuciones
// quedan fijadas a su versión — editar nunca rompe una ejecución en curso.
enum AutomationStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

model Automation {
  id                 String           @id @default(cuid())
  // Mutuamente excluyentes a nivel de aplicación — mismo patrón que WASequence.
  waAccountId        String?          @map("wa_account_id")
  waAccount          WAAccount?       @relation(fields: [waAccountId], references: [id], onDelete: Cascade)
  channelAccountId   String?          @map("channel_account_id")
  channelAccount     ChannelAccount?  @relation(fields: [channelAccountId], references: [id], onDelete: Cascade)
  name               String
  description        String?
  status             AutomationStatus @default(DRAFT)
  draftGraph         Json             @map("draft_graph")
  // Desnormalizados de la versión publicada para filtrar por índice al
  // evaluar disparadores (no hay que abrir el JSON de cada automatización).
  triggerType        String?          @map("trigger_type")
  triggerConfig      Json?            @map("trigger_config")
  conversational     Boolean          @default(false)
  publishedVersionId String?          @unique @map("published_version_id")
  publishedVersion   AutomationVersion? @relation("PublishedVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)
  // { exitOnReply, allowReentry } — ver lib/automations/settings.ts
  settings           Json             @default("{}")
  createdById        String           @map("created_by_id")
  createdBy          User             @relation(fields: [createdById], references: [id], onDelete: Cascade)
  organizationId   String       @map("organization_id")
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  versions AutomationVersion[] @relation("AutomationVersions")
  runs     AutomationRun[]
  aiUsage  AutomationAiUsage[]

  @@index([waAccountId, status, triggerType])
  @@index([channelAccountId, status, triggerType])
  @@index([organizationId])
  @@map("automations")
}

model AutomationVersion {
  id            String     @id @default(cuid())
  automationId  String     @map("automation_id")
  automation    Automation @relation("AutomationVersions", fields: [automationId], references: [id], onDelete: Cascade)
  version       Int
  graph         Json
  publishedAt   DateTime   @default(now()) @map("published_at")
  publishedById String     @map("published_by_id")
  publishedBy   User       @relation(fields: [publishedById], references: [id], onDelete: Cascade)

  publishedOf Automation?     @relation("PublishedVersion")
  runs        AutomationRun[]

  @@unique([automationId, version])
  @@map("automation_versions")
}

enum AutomationRunStatus {
  ACTIVE // encolada o avanzando ahora
  WAITING_DELAY
  WAITING_REPLY
  PAUSED_BY_AGENT // un humano respondió en el chat
  HANDED_OFF // terminó pasando la conversación a un humano
  HANDED_TO_BOT // terminó cediendo la conversación al bot IA
  COMPLETED
  EXITED_REPLY // el contacto respondió y la automatización sale al responder
  EXPIRED // ventana de 24 h cerrada sin plantilla de respaldo
  FAILED
  CANCELLED
}

model AutomationRun {
  id             String              @id @default(cuid())
  automationId   String              @map("automation_id")
  automation     Automation          @relation(fields: [automationId], references: [id], onDelete: Cascade)
  versionId      String              @map("version_id")
  version        AutomationVersion   @relation(fields: [versionId], references: [id], onDelete: Cascade)
  contactId      String              @map("contact_id")
  contact        Contact             @relation(fields: [contactId], references: [id], onDelete: Cascade)
  waChatId       String?             @map("wa_chat_id")
  waChat         WAChat?             @relation(fields: [waChatId], references: [id], onDelete: Cascade)
  conversationId String?             @map("conversation_id")
  conversation   Conversation?       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  status         AutomationRunStatus @default(ACTIVE)
  conversational Boolean             @default(false)
  // RunState del ejecutor: paso actual, variables y espera pendiente.
  currentNodeId  String?             @map("current_node_id")
  vars           Json                @default("{}")
  waiting        Json?
  // Entrada pendiente de procesar (respuesta del cliente / timeout) — la
  // escribe quien reanuda la ejecución y la consume el worker.
  pendingInput   Json?               @map("pending_input")
  // Se incrementa cada vez que llega una entrada nueva. El worker lo lee al
  // empezar a avanzar: si cambió al terminar, llegó otra respuesta mientras
  // avanzaba y no se borra pendingInput (se vuelve a encolar).
  inputSeq       Int                 @default(0) @map("input_seq")
  nextRunAt      DateTime?           @map("next_run_at")
  // Candado de avance: un solo worker a la vez por ejecución.
  lockedAt       DateTime?           @map("locked_at")
  attempts       Int                 @default(0)
  lastError      String?             @map("last_error") @db.Text
  startedAt      DateTime            @default(now()) @map("started_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  endedAt        DateTime?           @map("ended_at")

  logs    AutomationRunLog[]
  aiUsage AutomationAiUsage[]

  @@index([status, nextRunAt])
  @@index([waChatId, status])
  @@index([conversationId, status])
  @@index([automationId, contactId, status])
  @@index([contactId, startedAt])
  @@map("automation_runs")
}

model AutomationRunLog {
  id       String        @id @default(cuid())
  runId    String        @map("run_id")
  run      AutomationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  nodeId   String?       @map("node_id")
  nodeType String        @map("node_type")
  outcome  String
  detail   String        @db.Text
  at       DateTime      @default(now())

  @@index([runId, at])
  @@map("automation_run_logs")
}

// Consumo de IA de los pasos ai_classify / ai_extract / emparejado con IA.
// userId = dueño de la cuenta (quien paga): lib/ai/budget.ts lo suma al
// presupuesto mensual igual que WABotUsage/WALeadScorerUsage.
model AutomationAiUsage {
  id               String         @id @default(cuid())
  automationId     String         @map("automation_id")
  automation       Automation     @relation(fields: [automationId], references: [id], onDelete: Cascade)
  runId            String?        @map("run_id")
  run              AutomationRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  userId           String         @map("user_id")
  waChatId         String?        @map("wa_chat_id")
  conversationId   String?        @map("conversation_id")
  model            String
  promptTokens     Int            @map("prompt_tokens")
  completionTokens Int            @map("completion_tokens")
  totalTokens      Int            @map("total_tokens")
  estimatedCost    Float          @map("estimated_cost")
  createdAt        DateTime       @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([waChatId])
  @@index([conversationId])
  @@map("automation_ai_usage")
}

// ─── SaaS: espacios de trabajo ──────────────────────────────────────────────
// Un cliente = una Organization. Todo recurso de negocio cuelga de una (las
// entidades de primer nivel llevan organizationId; chats, contactos, mensajes y
// etiquetas la heredan de su cuenta). Plan, estado de suscripción y créditos de
// IA viven aquí — ver lib/billing y lib/tenancy.ts.
enum PlanId {
  BASIC
  PRO
}

enum OrganizationStatus {
  TRIALING
  ACTIVE
  PAST_DUE // pago fallido: funciona con aviso durante la gracia
  READ_ONLY // prueba vencida o gracia agotada: ve todo, no envía
  CANCELED
  SUSPENDED // suspendida por la plataforma: no puede entrar
}

model Organization {
  id                   String             @id @default(cuid())
  name                 String
  // Dueño: admin que no se puede degradar ni desactivar (antes, "el primer
  // usuario registrado").
  ownerId              String?            @unique @map("owner_id")
  owner                User?              @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  plan                 PlanId             @default(PRO)
  status               OrganizationStatus @default(TRIALING)
  // Organizaciones de la casa (la instalación original, demos): sin cobro ni
  // candados de facturación.
  isInternal           Boolean            @default(false) @map("is_internal")
  // Canales adicionales como feature por organización — el operador los
  // activa desde /plataforma (lib/channel-flags.ts). WhatsApp no tiene flag,
  // siempre disponible. Default false: una organización nueva solo tiene
  // WhatsApp hasta que se le habilite algo más.
  // Coexistencia de WhatsApp (conectar el número de la app WhatsApp Business):
  // bandera por organización durante la beta, apagada por defecto.
  whatsappCoexistenceEnabled Boolean       @default(false) @map("whatsapp_coexistence_enabled")
  channelTelegramEnabled  Boolean          @default(false) @map("channel_telegram_enabled")
  channelMessengerEnabled Boolean          @default(false) @map("channel_messenger_enabled")
  channelInstagramEnabled Boolean          @default(false) @map("channel_instagram_enabled")
  channelWebchatEnabled   Boolean          @default(false) @map("channel_webchat_enabled")
  trialEndsAt          DateTime?          @map("trial_ends_at")
  currentPeriodEnd     DateTime?          @map("current_period_end")
  graceEndsAt          DateTime?          @map("grace_ends_at")
  stripeCustomerId     String?            @unique @map("stripe_customer_id")
  stripeSubscriptionId String?            @unique @map("stripe_subscription_id")
  // El cliente canceló desde el portal: sigue activa hasta currentPeriodEnd.
  cancelAtPeriodEnd    Boolean            @default(false) @map("cancel_at_period_end")
  // Cuándo pasó a CANCELED — la purga de datos corre RETENTION_DAYS_AFTER_CANCEL después.
  canceledAt           DateTime?          @map("canceled_at")
  // Último aviso de facturación enviado (clave del aviso + fecha), para no
  // repetir el mismo correo/notificación en cada tick.
  lastBillingNotice    String?            @map("last_billing_notice")
  aiCreditsUsed        Int                @default(0) @map("ai_credits_used")
  // Créditos extra del periodo actual dados por la plataforma (/plataforma);
  // se reinician a 0 junto con el consumo.
  aiCreditsBonus       Int                @default(0) @map("ai_credits_bonus")
  aiCreditsPeriodStart DateTime           @default(now()) @map("ai_credits_period_start")
  // Último umbral de créditos avisado en el periodo (0, 80 o 100).
  aiCreditsAlertLevel  Int                @default(0) @map("ai_credits_alert_level")

  // Operación de la organización (antes vivían por usuario en AppSettings):
  // zona horaria y horario laboral (recuperación de leads, citas del bot,
  // importación de hojas) y la recuperación automática de leads.
  timezone                       String  @default("America/Mexico_City")
  businessHourStart              Int     @default(8) @map("business_hour_start")
  businessHourEnd                Int     @default(20) @map("business_hour_end")
  leadRecoveryEnabled            Boolean @default(false) @map("lead_recovery_enabled")
  leadRecoveryFirstMessageHours  Int     @default(2) @map("lead_recovery_first_message_hours")
  // null = solo se manda 1 mensaje.
  leadRecoverySecondMessageHours Int?    @default(12) @map("lead_recovery_second_message_hours")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  members          User[]            @relation("OrganizationMembers")
  waAccounts       WAAccount[]
  stickers         WASticker[]
  channelAccounts  ChannelAccount[]
  bots             WABot[]
  leadScorers      WALeadScorerBot[]
  metaAdsAccounts  MetaAdsAccount[]
  apiKeys          ApiKey[]
  webhookEndpoints WebhookEndpoint[]
  automations      Automation[]
  sequences        WASequence[]
  campaigns        WACampaign[]
  leadSheetSources LeadSheetSource[]
  people           Person[]
  companies        Company[]
  activityLogs     ActivityLog[]
  savedViews       SavedView[]
  importRuns       ImportRun[]
  authTokens       AuthToken[]

  @@index([status])
  @@map("organizations")
}

enum AuthTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
  INVITE
}

// Enlaces de un solo uso enviados por correo. Solo se guarda el hash del token
// (sha256): una fuga de la base no permite usar enlaces vigentes.
// INVITE no tiene userId (el invitado aún no existe): lleva organizationId,
// email y el rol con el que entrará.
model AuthToken {
  id             String        @id @default(cuid())
  type           AuthTokenType
  tokenHash      String        @unique @map("token_hash")
  email          String
  userId         String?       @map("user_id")
  user           User?         @relation("AuthTokenUser", fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           String?
  invitedById    String?       @map("invited_by_id")
  invitedBy      User?         @relation("AuthTokenInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  expiresAt      DateTime      @map("expires_at")
  usedAt         DateTime?     @map("used_at")
  createdAt      DateTime      @default(now()) @map("created_at")

  @@index([userId, type])
  @@index([organizationId, type])
  @@map("auth_tokens")
}

// Eventos del webhook de Stripe ya procesados (idempotencia por event.id:
// Stripe reintenta y puede entregar el mismo evento más de una vez).
model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("stripe_events")
}

// Configuración de negocio de la plataforma (IA, Stripe, SMTP, Turnstile,
// medición), editable desde /plataforma en vez de variables de entorno. Fila
// única con id fijo "platform" — ver lib/platform-settings.ts, el único punto
// que la lee/escribe. Los campos marcados "cifrado" pasan por lib/crypto.ts
// antes de guardarse; nunca se re-exponen en texto plano vía la API (solo un
// booleano "configurado"). Lo que NO vive aquí (DATABASE_URL, REDIS_URL,
// AUTH_SECRET, ENCRYPTION_KEY, APP_URL, PLATFORM_ADMIN_EMAILS) es
// infraestructura de arranque y se queda en env — ver AGENTS.md.
// Solicitudes de eliminación de datos que Meta manda al callback firmado
// (/api/meta/data-deletion). Meta pide devolver un código de confirmación y una
// URL pública donde el usuario consulta el estado.
model MetaDataDeletionRequest {
  id               String    @id @default(cuid())
  confirmationCode String    @unique @map("confirmation_code")
  metaUserId       String    @map("meta_user_id")
  // RECEIVED = recibida, COMPLETED = se borraron los datos de las cuentas que
  // coinciden, NO_DATA = no había cuentas asociadas a ese usuario.
  status           String    @default("RECEIVED")
  accountsDeleted  Int       @default(0) @map("accounts_deleted")
  receivedAt       DateTime  @default(now()) @map("received_at")
  completedAt      DateTime? @map("completed_at")

  @@index([metaUserId])
  @@map("meta_data_deletion_requests")
}

model PlatformSettings {
  id String @id @default("platform")

  // IA (lib/ai/platform.ts)
  opencodeApiKey String? @map("opencode_api_key") // cifrado
  googleApiKey   String? @map("google_api_key") // cifrado

  // Stripe (lib/billing/stripe.ts)
  stripeSecretKey     String? @map("stripe_secret_key") // cifrado
  stripeWebhookSecret String? @map("stripe_webhook_secret") // cifrado
  stripePriceBasic    String? @map("stripe_price_basic")
  stripePricePro      String? @map("stripe_price_pro")

  // SMTP (lib/email/mailer.ts)
  smtpHost   String?  @map("smtp_host")
  smtpPort   Int?     @map("smtp_port")
  smtpSecure Boolean  @default(false) @map("smtp_secure")
  smtpUser   String?  @map("smtp_user")
  smtpPass   String?  @map("smtp_pass") // cifrado
  emailFrom  String?  @map("email_from")

  // Captcha (lib/turnstile.ts)
  turnstileSiteKey   String? @map("turnstile_site_key")
  turnstileSecretKey String? @map("turnstile_secret_key") // cifrado

  // App de Meta de la plataforma (Embedded Signup y coexistencia de WhatsApp;
  // lib/meta/platform-app.ts). El App Secret firma los webhooks de las cuentas
  // EMBEDDED_SIGNUP y los callbacks signed_request; el token de verificación es
  // el del GET de suscripción del webhook de la app.
  metaAppId                  String? @map("meta_app_id")
  metaAppSecret              String? @map("meta_app_secret") // cifrado
  metaEmbeddedSignupConfigId String? @map("meta_embedded_signup_config_id")
  metaWebhookVerifyToken     String? @map("meta_webhook_verify_token") // cifrado

  // Medición del sitio público (lib/analytics/)
  metaPixelId          String? @map("meta_pixel_id")
  metaCapiAccessToken  String? @map("meta_capi_access_token") // cifrado
  gaMeasurementId      String? @map("ga_measurement_id")
  googleAdsId          String? @map("google_ads_id")
  googleAdsSignupLabel String? @map("google_ads_signup_label")

  // Respaldo diario a un almacenamiento compatible con S3 (AWS S3, Cloudflare
  // R2, MinIO, Backblaze…; lib/backups/). Sobrescribe el respaldo anterior.
  // backupEndpoint vacío = AWS; con endpoint se usa direccionamiento por ruta.
  backupEnabled         Boolean @default(false) @map("backup_enabled")
  backupEndpoint        String? @map("backup_endpoint")
  backupRegion          String? @map("backup_region")
  backupBucket          String? @map("backup_bucket")
  backupPrefix          String? @map("backup_prefix")
  backupAccessKeyId     String? @map("backup_access_key_id") // cifrado
  backupSecretAccessKey String? @map("backup_secret_access_key") // cifrado
  backupHour            Int     @default(3) @map("backup_hour") // hora de Ciudad de México
  backupIncludeMedia    Boolean @default(false) @map("backup_include_media")

  updatedAt      DateTime @updatedAt @map("updated_at")
  updatedByEmail String?  @map("updated_by_email")

  @@map("platform_settings")
}

enum PlatformBackupStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum PlatformBackupTrigger {
  SCHEDULED
  MANUAL
}

// Historial de respaldos de la plataforma (no por organización). Se conservan
// 90 días; el respaldo en sí vive en el almacenamiento externo.
model PlatformBackupRun {
  id           String                @id @default(cuid())
  trigger      PlatformBackupTrigger
  status       PlatformBackupStatus  @default(RUNNING)
  startedAt    DateTime              @default(now()) @map("started_at")
  finishedAt   DateTime?             @map("finished_at")
  dbBytes      BigInt?               @map("db_bytes")
  mediaBytes   BigInt?               @map("media_bytes")
  error        String?               @db.Text
  triggeredBy  String?               @map("triggered_by") // correo del operador (manual)

  @@index([startedAt])
  @@map("platform_backup_runs")
}
