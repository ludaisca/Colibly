  "narrative": {
    "northStar": "Andén",
    "overview": "El panel es el tablero de un andén: lo que importa es quién lleva más tiempo esperando, y el tiempo es el dato protagonista. Cada cuenta es una línea con su color; cada conversación avanza por estaciones hasta la venta. Dos temas de primera: concreto de día y andén de noche.",
    "keyCharacteristics": [
      "La espera como cifra de tablero con lámpara ámbar o roja.",
      "Una línea de color por cuenta en filas, tarjetas y chips.",
      "Selección en tinta; el teal Laguna solo para la acción principal y el foco.",
      "Superficies blancas planas sobre concreto.",
      "Barra inferior en el celular: Chats, Contactos, Pipeline, Más."
    ],
    "rules": [
      {
        "name": "La regla de la tinta",
        "body": "Lo seleccionado se marca en tinta; el teal es para actuar, no para señalar dónde estás.",
        "section": "colors"
      },
      {
        "name": "La regla de la lámpara",
        "body": "Ámbar y rojo solo encienden por tiempo de espera o SLA; ningún adorno usa esos colores.",
        "section": "colors"
      },
      {
        "name": "La regla del título solo",
        "body": "Ningún título lleva etiqueta encima; se sostiene solo.",
        "section": "typography"
      },
      {
        "name": "La regla del piso",
        "body": "Nada en el panel va por debajo de 11px (text-micro); los tamaños escritos a mano no se usan.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do marcar la selección en tinta y la acción en Laguna.",
      "Do usar hueClassFor(id) para toda línea de cuenta.",
      "Do mostrar la espera con WaitCells donde un chat espera respuesta."
    ],
    "donts": [
      "Don't poner etiquetas sobre los títulos.",
      "Don't usar ámbar o rojo fuera de espera/SLA/errores.",
      "Don't agregar sombras o saltos a controles en reposo.",
      "Don't usar referencias folclóricas o exclusivas de un país.",
      "Don't usar Tailwind dark:; el tema lo controla la app."
