{
	"name": "n8n-nodes-colibly",
	"version": "0.3.1",
	"description": "Nodos de n8n para Colibly, el CRM para WhatsApp: contactos, conversaciones, mensajes, plantillas, automatizaciones y un disparador por webhook firmado.",
	"license": "MIT",
	"homepage": "https://colibly.com",
	"keywords": [
		"n8n-community-node-package",
		"colibly",
		"whatsapp",
		"crm"
	],
	"author": {
		"name": "Colibly",
		"email": "contacto@colibly.com"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "node --test --experimental-strip-types ../n8n-tests/*.test.ts",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"!dist/tsconfig.tsbuildinfo",
		"!dist/**/*.map"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/ColiblyApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Colibly/Colibly.node.js",
			"dist/nodes/ColiblyTrigger/ColiblyTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.55.6",
		"eslint": "9.32.0",
		"n8n-workflow": "^2.16.0",
		"prettier": "3.6.2",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
